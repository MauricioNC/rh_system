<fieldset class="border border-gray-400">
  <legend>Datos laborales</legend>

  <div>
    <%= f.label :start_date, "Fecha de inicio" %>
    <%= f.date_field :start_date, class: "border border-gray-500" %>
  </div>

  <div>
    <%= f.label :end_date, "Fecha de termino" %>
    <%= f.date_field :end_date, class: "border border-gray-500" %>
  </div>

  <div>
    <div>
      <%= f.label :position_code, "Codigo del puesto" %>
      <%= f.text_field :position_code, class: "border border-gray-500" %>
    </div>
  
    <div>
      <%= f.label :position_desc, "Descripcion del puesto" %>
      <%= f.text_field :position_desc, class: "border border-gray-500" %>
      <%= f.hidden_field :position_id %>
    </div>
  </div>

  <div>
    <div>
      <%= f.label :resp_center_code, "Codigo Centro de Responsabilidad" %>
      <%= f.text_field :resp_center_code, class: "border border-gray-500" %>
    </div>

    <div>
      <%= f.label :resp_center_desc, "Descripcion del Centro de Responsabilidad" %>
      <%= f.text_field :resp_center_desc, class: "border border-gray-500" %>
      <%= f.hidden_field :resp_center_id %>
    </div>
  </div>

  <div>
    <%= f.label :contract_type, "Tipo de contrato" %>
    <%= f.select :contract_type_id, ContractType.all.collect { |ct| [ct.description, ct.id] }, { include_blank: false }, class: "border border-gray-500" %>
  </div>

  <div>
    <%= f.label :employee_type, "Tipo de empleado" %>
    <%= f.select :employee_type_id, EmployeeType.all.collect { |et| [et.description, et.id] }, { include_blank: false }, class: "border border-gray-500" %>
  </div>
</fieldset>